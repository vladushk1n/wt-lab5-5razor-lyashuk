@page
@model wt_lab5_5razor_lyashuk.Pages.Players.IndexModel

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Киберспортивные игроки</h1>
            <p class="text-muted">Каталог участников турнира</p>
        </div>
        <a asp-page="/Players/Create" class="btn btn-primary">Добавить игрока</a>
    </div>

    <div class="row g-4">
        @foreach (var player in Model.Players)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @player.Id</span>
                        <h5 class="card-title">@player.Nickname</h5>
                        <p class="text-muted mb-1">Роль: @player.Role</p>
                        <p class="fs-5 fw-bold text-success mb-3">MMR: @player.Rating</p>
                        <a asp-page="/Players/Details" asp-route-id="@player.Id" class="btn btn-outline-primary">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>